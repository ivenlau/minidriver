{
  "name": "minidriver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal cloud drive on Cloudflare Workers — passkey auth, file management, temporary shares",
  "scripts": {
    "dev": "concurrently -c yellow,cyan -n api,web \"node scripts/ensure-dist.mjs && wrangler dev\" \"vite dev\"",
    "dev:api": "node scripts/ensure-dist.mjs && wrangler dev",
    "dev:web": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply minidriver --local",
    "db:migrate:remote": "wrangler d1 migrations apply minidriver --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "hono": "^4.13.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  }
}
